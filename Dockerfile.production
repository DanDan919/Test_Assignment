FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY NuGet.Config ./
COPY src/TestTask.Api/TestTask.Api.csproj src/TestTask.Api/
COPY src/TestTask.Api/packages.lock.json src/TestTask.Api/
RUN dotnet restore src/TestTask.Api/TestTask.Api.csproj --locked-mode
COPY src/ src/
RUN dotnet publish src/TestTask.Api/TestTask.Api.csproj -c Release --no-restore -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/ ./
ENV ASPNETCORE_URLS=http://+:8090
ENV DOTNET_EnableDiagnostics=0
USER $APP_UID
EXPOSE 8090
ENTRYPOINT ["dotnet", "TestTask.Api.dll"]
